# ---------------------------------------------------------------------------
# Sanity — the content system where you add products and change prices.
# Get these from https://sanity.io/manage after creating a project.
# The site runs on built-in sample products until you fill these in.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Paystack — payments (cards, MTN MoMo, Telecel Cash, AT Money).
# Get these from https://dashboard.paystack.com/#/settings/developers
# Start with the sk_test_ / pk_test_ pair. Never commit the secret key.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=233200000000

# ---------------------------------------------------------------------------
# Resend — order confirmations, contact form and newsletter signups.
# Get a key from https://resend.com and verify your sending domain.
# Without it, forms still succeed and the message is logged instead of sent.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Fashionova <atelier@fashionova.com>"
